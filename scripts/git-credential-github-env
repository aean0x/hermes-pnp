#!/usr/bin/env bash
# Git credential helper: github.com HTTPS via GITHUB_TOKEN / GH_TOKEN.
# git-hook push/pull and any other hermes-user git to GitHub.
# No token → exit 0 (git treats that as "no credentials").
# Wired by modules/git.nix onto programs.git; /nix/store is bind-mounted
# into the gateway jail so the same store path works on host and inside.
set -euo pipefail

_token_from_envfile() {
  local file="$1" line="" name
  [[ -n "$file" && -r "$file" ]] || return 1
  for name in GITHUB_TOKEN GH_TOKEN; do
    line="$(grep -E "^${name}=" "$file" | tail -n1 || true)"
    [[ -n "$line" ]] || continue
    line="${line#${name}=}"
    line="${line#\"}"
    line="${line%\"}"
    line="${line#\'}"
    line="${line%\'}"
    [[ -n "$line" ]] || continue
    printf '%s' "$line"
    return 0
  done
  return 1
}

# Only respond to get; store/erase are no-ops (token is ephemeral env).
op="${1:-get}"
case "$op" in
  get)
    token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
    if [[ -z "$token" ]]; then
      for f in \
        "${HERMES_HOME:-}/.env" \
        /var/lib/hermes/.hermes/.env \
        /data/.hermes/.env \
        /run/hermes.env \
        /tmp/hermes-test.env
      do
        token="$(_token_from_envfile "$f" || true)"
        [[ -n "$token" ]] && break
      done
    fi
    if [[ -z "$token" ]]; then
      exit 0
    fi
    host=""
    while IFS= read -r line; do
      [[ -z "$line" ]] && break
      case "$line" in
        host=*) host="${line#host=}" ;;
      esac
    done
    if [[ "$host" != "github.com" && -n "$host" ]]; then
      exit 0
    fi
    printf 'username=x-access-token\npassword=%s\n' "$token"
    ;;
  store | erase)
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
