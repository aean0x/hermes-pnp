+def _estimate_total_tokens(
+    messages: list[dict[str, Any]], state: SessionState
+) -> int:
+    """Sum per-message token estimates, memoized by message identity.
+
+    ``estimate_message_tokens`` is a pure function of a message's API-visible
+    fields, and the strategy passes above already ran, so the estimate
+    reflects the same post-mutation content the model sees.  Messages are
+    immutable between turns except for HMC's own restore->re-mutate cycle
+    (which reproduces identical content) and external rewrites (Hermes
+    compaction), both of which change ``len(content)`` for every practical
+    case; the length guard invalidates the cache entry when they don't.
+    Cache keys are process-local ``id()`` values, so the cache is
+    runtime-only (never persisted) and self-heals on state reload.
+    """
+    cache = state.message_token_cache
+    total = 0
+    for message in messages:
+        key = id(message)
+        content = message.get("content")
+        content_len = len(content) if isinstance(content, str) else -1
+        entry = cache.get(key)
+        if entry is not None and entry[0] == content_len:
+            total += entry[1]
+        else:
+            tokens = estimate_message_tokens(message)
+            cache[key] = (content_len, tokens)
+            total += tokens
+    return total
