+    def _delete_unreferenced_system_prompts(conn, keep_hash: Optional[str] = None) -> None:
+        # ``keep_hash``: the prompt row this transaction just stored. On the
+        # first turn of a session the UPDATE that references it affects zero
+        # rows (the session row does not exist yet — _ensure_db_session runs
+        # later), so a naive "not referenced by any session" DELETE would
