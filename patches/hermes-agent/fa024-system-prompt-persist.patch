+        # next turn's restore finds system_prompt NULL and rebuilds (FA-024
+        # prefix-cache miss). Exclude the just-stored hash so the row survives
+        # until the session references it; the periodic cleanup removes it
+        # once it is genuinely orphaned.
         conn.execute(
