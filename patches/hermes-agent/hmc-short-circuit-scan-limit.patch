+# Shape markers (status ok, bytes_written, pytest "N passed", git clean)
+# live at the head/tail of tool output. Full-string regex passes over a
+# multi-MB tool result (the DOTALL `.*` in the JSON rules backtracks) cost
+# seconds per message, and the plugin's pre_llm_call hook has a 30s budget
+# shared with everything else — on 1M+ token sessions materialize_view
+# alone was exceeding it (HMC pre_llm_call timed out after 30s). Scan the
+# head+tail window for the RULES; the error-indicator guard above still
+# scans the full content so an error mid-output can never be short-circuited
+# away.
+_SHAPE_SCAN_LIMIT = 8192
+
+
+def _shape_scan_window(content: str) -> str:
+    """Bound the content the shape rules examine to a head+tail window."""
+    if len(content) <= _SHAPE_SCAN_LIMIT:
+        return content
+    return content[:_SHAPE_SCAN_LIMIT] + content[-_SHAPE_SCAN_LIMIT:]
+
 
