# Copy into a sops.templates.hermesEnv (or equivalent) and list that
# path on services.hermesPnP.environmentFiles.
# Include every provider named in services.hermesPnP.models.*.

# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Optional Hermes tools (uncomment what you use)
# BRAVE_SEARCH_API_KEY=
# FIRECRAWL_API_KEY=
# ELEVENLABS_API_KEY=

# Optional. git-hook / hermes-user git push-pull to https://github.com
# GITHUB_PAT=
# GH_TOKEN=

# GBrain: set services.hermesPnP.gbrain.tokenFile, do not put the token here.
# Telegram / mail / other site identity: consumer module, not this file.
